<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- XDG dirs from .chezmoidata/xdg.toml, set at login for every app launchd
     starts; the macOS side of ~/.config/environment.d on Linux. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>xyz.samuelmurillo.environment</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>
{{- range $name, $path := .xdg }}
launchctl setenv {{ $name }} {{ joinPath $.chezmoi.homeDir $path | quote }}
{{- end }}
    </string>
  </array>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
