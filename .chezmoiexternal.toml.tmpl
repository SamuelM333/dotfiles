[".config/ghostty/shaders/ghostty-shaders"]
    type = "git-repo"
    url = "https://github.com/0xhckr/ghostty-shaders.git"
    refreshPeriod = "168h" # 7 days
# Fedora's ghostty package ships without bundled themes (licensing, see
# mbadolato/iTerm2-Color-Schemes#638), so fetch the ones the config uses.
[".config/ghostty/themes/Adwaita"]
    type = "file"
    url = "https://raw.githubusercontent.com/mbadolato/iTerm2-Color-Schemes/master/ghostty/Adwaita"
    refreshPeriod = "168h" # 7 days

[".config/ghostty/themes/Adwaita Dark"]
    type = "file"
    url = "https://raw.githubusercontent.com/mbadolato/iTerm2-Color-Schemes/master/ghostty/Adwaita%20Dark"
    refreshPeriod = "168h" # 7 days

# Agent skills, shared by every coding agent through ~/.agents/skills
# (dot_claude/skills links them into Claude Code).
# Pinned to a commit: skills are instructions and scripts agents run, so
# review upstream changes before bumping a commit.
{{- $skills := list
      (dict "repo" "JuliusBrussee/caveman" "commit" "9b68f7ed12b05e7efaff18e65c5a3fc2849fd0a4"
            "names" (list "caveman" "caveman-commit" "caveman-compress" "caveman-explore" "caveman-help" "caveman-review"))
      (dict "repo" "vercel-labs/skills" "commit" "92a9a34ac3bf88e695e468b90c7bf32f163d32c8"
            "names" (list "find-skills")) }}
{{- range $skills }}
{{-   $src := . }}
{{-   range .names }}

[".agents/skills/{{ . }}"]
    type = "archive"
    url = "https://github.com/{{ $src.repo }}/archive/{{ $src.commit }}.tar.gz"
    stripComponents = 3
    include = ["*/skills/{{ . }}/**"]
    exact = true
{{-   end }}
{{- end }}
