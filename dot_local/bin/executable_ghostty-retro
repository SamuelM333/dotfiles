#!/bin/sh
# Turn ghostty's retro terminal look (theme and CRT shaders) on or off at
# runtime, then reload every running ghostty.
# Usage: ghostty-retro [toggle|on|off|status]   (default: toggle)

# Ghostty reads this file through `config-file`; chezmoi doesn't manage it
INCLUDE="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/retro.ghostty"

# The include's first line holds the state: "# ghostty-retro: <on|off>"
state=$(sed -n '1s/^# ghostty-retro: //p' "$INCLUDE" 2>/dev/null)
[ "$state" = on ] || state=off

case "${1:-toggle}" in
    toggle) if [ "$state" = on ]; then state=off; else state=on; fi ;;
    on | off) state=$1 ;;
    status)
        echo "ghostty retro: $state"
        exit 0
        ;;
    *)
        echo "usage: ghostty-retro [toggle|on|off|status]" >&2
        exit 2
        ;;
esac

{
    echo "# ghostty-retro: $state"
    echo "# Written by ghostty-retro. Run it again to switch; don't edit by hand."
    if [ "$state" = on ]; then
        cat <<EOF
theme = light:Xcode Light hc,dark:Xcode Dark hc
custom-shader = ./shaders/ghostty-shaders/retro-terminal.glsl
custom-shader = ./shaders/ghostty-shaders/tft.glsl
custom-shader = ./shaders/ghostty-shaders/bloom.glsl
EOF
    fi
} > "$INCLUDE"

# SIGUSR2 makes ghostty reload its config
pkill -USR2 -x ghostty 2>/dev/null
echo "ghostty retro: $state"
