#!/bin/bash
# Install the OpenRazer daemon into a Python venv under ~/.local/share/openrazer
# instead of layering openrazer-daemon with rpm-ostree, which blocks Bazzite updates.
# The kernel modules (kmod-openrazer) and udev rules already ship in the image.
# Reruns when the version below or the system Python version changes.
# OpenRazer {{ .openrazer.version }}, sha256 {{ .openrazer.sha256 }}
# Python {{ output "/usr/bin/python3" "-c" "import sys; print(sys.version.split()[0])" | trim }}
set -euo pipefail

version={{ .openrazer.version | quote }}
sha256={{ .openrazer.sha256 | quote }}
prefix="$HOME/.local/share/openrazer"
venv="$prefix/venv"

if ! modinfo razerkbd >/dev/null 2>&1; then
    echo "openrazer: no razerkbd kernel module, skipping daemon install" >&2
    exit 0
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

curl -fsSL -o "$tmp/openrazer.tar.gz" \
    "https://github.com/openrazer/openrazer/archive/refs/tags/v${version}.tar.gz"
echo "$sha256  $tmp/openrazer.tar.gz" | sha256sum --check --quiet
tar -xzf "$tmp/openrazer.tar.gz" -C "$tmp"
src="$tmp/openrazer-${version}/daemon"

# System Python, not linuxbrew's: the venv reuses the image's dbus-python,
# PyGObject, pyudev and setproctitle, which need system headers to build.
rm -rf "$venv"
/usr/bin/python3 -m venv --system-site-packages "$venv"
"$venv/bin/pip" install --quiet --disable-pip-version-check "$src"

install -m 755 "$src/run_openrazer_daemon.py" "$venv/bin/openrazer-daemon"
sed -i "1s|.*|#!$venv/bin/python3|" "$venv/bin/openrazer-daemon"

config="${XDG_CONFIG_HOME:-$HOME/.config}/openrazer/razer.conf"
if [ ! -e "$config" ]; then
    install -m 644 -D "$src/resources/razer.conf" "$config"
fi

systemctl --user daemon-reload
systemctl --user enable openrazer-daemon.service
systemctl --user restart openrazer-daemon.service
