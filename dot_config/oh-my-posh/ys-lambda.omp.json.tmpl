{{- /* chezmoi:template:left-delimiter=[[[ right-delimiter=]]] */ -}}
{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": false,
    "notice": false
  },
  "palettes": {
    "template": "{{ if eq .Env.GHOSTTY_RETRO \"on\" }}retro{{ else }}default{{ end }}",
    "list": {
      "default": {
        "user-host": "#D75F00"
      },
      "retro": {
        "user-host": "darkGray"
      }
    }
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "options": {
            "fetch_version": false
          },
          "template": "({{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }})",
          "foreground": "white",
          "type": "python",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "# ",
          "foreground": "#D75F00",
          "type": "text",
          "style": "plain"
        },
        {
          "template": " % ",
          "foreground": "red",
          "type": "root",
          "style": "plain"
        },
        {
          "template": "<p:user-host>{{ .UserName }}</> <darkGray>@</> ",
          "type": "session",
          "style": "plain"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:user-host",
          "template": "<p:user-host>[[[- or .pretty_hostname .chezmoi.hostname -]]]</> "
        },
        {
          "options": {
            "style": "agnoster_short",
            "max_depth": 3
          },
          "template": "<darkGray>in </>{{ .Path }} ",
          "foreground": "cyan",
          "type": "path",
          "style": "plain"
        },
        {
          "options": {
            "fetch_status": true
          },
          "template": "<darkGray>on</> <white>git:</><cyan>{{ .HEAD }}</>{{ if not .Detached }} <darkGray>at</> <cyan>{{ .ShortHash }}</>{{ end }}{{ if .Working.Changed }}<red> x</>{{ end }} ",
          "type": "git",
          "style": "plain"
        },
        {
          "template": "[{{ .CurrentDate | date .Format }}]",
          "foreground": "darkGray",
          "type": "time",
          "style": "plain"
        },
        {
          "template": " C:{{ if gt .Code 0 }}{{ .Code }}{{ end }} ",
          "foreground": "red",
          "type": "status",
          "style": "plain"
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "λ",
          "foreground": "#D75F00",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": true
    }
  ],
  "console_title_template": "{{.UserName}}@{{.HostName}} | {{.Shell}} | {{.PWD}}",
  "version": 4,
  "final_space": true
}