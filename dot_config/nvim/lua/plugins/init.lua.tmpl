return {
  {
    "WantDead/theme-sync.nvim",
    lazy = false,
    opts = {},
    config = function()
      require("theme-sync").setup({
        -- Brew's gsettings lacks the dconf backend and always reports 'default',
        -- so ask the XDG desktop portal (1 = prefer dark, 2 = prefer light).
        detect = function()
          -- No gdbus (e.g. macOS): nil falls back to the plugin's built-in detection.
          if vim.fn.executable "gdbus" == 0 then
            return nil
          end
          local out = vim.fn.system {
            "gdbus", "call", "--session",
            "--dest", "org.freedesktop.portal.Desktop",
            "--object-path", "/org/freedesktop/portal/desktop",
            "--method", "org.freedesktop.portal.Settings.ReadOne",
            "org.freedesktop.appearance", "color-scheme",
          }
          if vim.v.shell_error ~= 0 then
            return nil
          end
          local value = out:match "uint32 (%d)"
          return value == "1" and "dark" or value == "2" and "light" or nil
        end,
        on_change = function(mode)
          require("nvconfig").base46.theme = mode == "dark" and "onedark" or "one_light"
          require("base46").load_all_highlights()
        end,
      })
    end,
  },

  -- C-h/j/k/l move between Neovim splits and tmux panes (tmux side in ~/.config/tmux).
  -- The keymaps are set in mappings.lua, after NvChad's own C-h/j/k/l.
  {
    "christoomey/vim-tmux-navigator",
    lazy = false,
    init = function()
      vim.g.tmux_navigator_no_mappings = 1
    end,
  },

  -- LuaSnip's submodules only feed the optional jsregexp build, which we don't run.
  -- Recursing into them broke a lazy update when upstream reshuffled them, leaving
  -- a half-checked-out tree that lazy then reports as "local changes".
  {
    "L3MON4D3/LuaSnip",
    submodules = false,
  },

  {
    "NeogitOrg/neogit",
    cmd = "Neogit",
    dependencies = {
      "sindrets/diffview.nvim",
    },
    config = function()
      require("neogit").setup(require "configs.neogit")
    end,
  },

  {
    "stevearc/conform.nvim",
    -- event = 'BufWritePre', -- uncomment for format on save
    opts = require "configs.conform",
  },

  -- These are some examples, uncomment them if you want to see them work!
  {
    "neovim/nvim-lspconfig",
    config = function()
      require "configs.lspconfig"
    end,
  },

  -- test new blink
  -- { import = "nvchad.blink.lazyspec" },

  -- Neovim 0.12 requires nvim-treesitter's `main` branch (NvChad still pins `master`).
  {
    "nvim-treesitter/nvim-treesitter",
    branch = "main",
    lazy = false,
    priority = 1000,
    build = function()
      if vim.fn.executable "tree-sitter" == 1 then
        vim.cmd.TSUpdate()
      end
    end,
    opts = function()
      local opts = require "configs.treesitter"
      return { install_dir = opts.install_dir }
    end,
    config = function(_, opts)
      require("nvim-treesitter").setup(opts)
      vim.schedule(function()
        require("configs.treesitter").install_optional { quiet = true }
      end)
    end,
  },

  -- MCP Hub (MCP server management)
  {
    "ravitemer/mcphub.nvim",
    dependencies = {
      "nvim-lua/plenary.nvim",
    },
    build = 'bash -lc "npm install -g mcp-hub@latest"',
    cmd = "MCPHub",
    config = function()
      require("mcphub").setup(require "configs.mcphub")
    end,
  },

  -- Snacks input UI (also used by Neogit)
  {
    "folke/snacks.nvim",
    priority = 1000,
    lazy = false,
    opts = {
      input = { enabled = true },
    },
  },
}
