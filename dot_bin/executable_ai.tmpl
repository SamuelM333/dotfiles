#!/usr/bin/env bash
# ai TITLE [COLOR]
#
# Open a tmux window named TITLE in the current directory with Neovim on the
# left and the AI agent on the right, or switch to it if it already exists.
# COLOR (tmux color: red, colour208, #ff8800, ...) colors the window's tab.
#
# Windows live in the current tmux session, or in the "ai" session when run
# outside tmux. Override with AI_SESSION, and the agent with AI_AGENT.
set -euo pipefail

usage() {
  echo "usage: ai TITLE [COLOR]" >&2
  exit 2
}

[[ $# -ge 1 && $# -le 2 && -n $1 ]] || usage
title=$1
color=${2:-}
{{- if eq .chezmoi.os "darwin" }}
agent=${AI_AGENT:-agent} # Cursor CLI
{{- else }}
agent=${AI_AGENT:-claude}
{{- end }}
dir=$PWD

if [[ -n ${TMUX:-} ]]; then
  session=$(tmux display-message -p '#{session_name}')
else
  session=${AI_SESSION:-ai}
fi

# Existing window with this title in the session (matched on @ai_title, so a
# manual rename doesn't create a duplicate).
win=""
if tmux has-session -t "=$session" 2>/dev/null; then
  # tmux turns tabs into "_" in -F output, so split on the first space instead
  # (window ids never contain one, titles may).
  win=$(tmux list-windows -t "=$session" -F '#{window_id} #{@ai_title}' |
    awk -v t="$title" '{ id = $1; sub(/^[^ ]+ /, ""); if ($0 == t) { print id; exit } }')
fi

if [[ -z $win ]]; then
  if tmux has-session -t "=$session" 2>/dev/null; then
    win=$(tmux new-window -d -t "=$session:" -n "$title" -c "$dir" -P -F '#{window_id}')
  else
    win=$(tmux new-session -d -s "$session" -n "$title" -c "$dir" -P -F '#{window_id}')
  fi
  tmux set-option -w -t "$win" @ai_title "$title"
  editor_pane=$(tmux display-message -p -t "$win" '#{pane_id}')
  agent_pane=$(tmux split-window -h -d -l 45% -t "$editor_pane" -c "$dir" -P -F '#{pane_id}')
  # Start both through the shell, so quitting nvim or the agent leaves a prompt.
  tmux send-keys -t "$editor_pane" "nvim ." Enter
  tmux send-keys -t "$agent_pane" "$agent" Enter
  tmux select-pane -t "$editor_pane"
fi

if [[ -n $color ]]; then
  tmux set-option -w -t "$win" @color "$color"
fi

if [[ -n ${TMUX:-} ]]; then
  tmux switch-client -t "$win"
elif [[ -t 1 ]]; then
  tmux select-window -t "$win"
  exec tmux attach-session -t "=$session"
else
  echo "ai: $session:$title is ready, attach with: tmux attach -t $session" >&2
fi
