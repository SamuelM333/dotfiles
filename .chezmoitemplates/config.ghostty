command = "zsh"
cursor-style-blink = true
link-url = true
clipboard-trim-trailing-spaces = true
# right-click-action = copy-or-paste
window-inherit-font-size = true
window-inherit-working-directory = true
window-theme = system
mouse-hide-while-typing = true
font-size = {{ .ghostty_font_size -}}

{{ if .ghostty_retro_terminal }}
theme = light:Xcode Light hc,dark:Xcode Dark hc
# Shader list, written by `ghostty-crt` (^X^S in zsh) to switch flat/curved CRT
config-file = ?shaders.ghostty
# Ghostty can't run commands, so send ^X^S to zsh's ghostty-crt widget
keybind = ctrl+shift+s=text:\x18\x13
{{ else }}
theme = light:Adwaita,dark:Adwaita Dark
{{ end -}}
