#!/bin/bash

SHADER_REPO={{ joinPath .chezmoi.homeDir ".config/ghostty/shaders/ghostty-shaders" | quote }}
FLAT_SHADER={{ joinPath .chezmoi.homeDir ".config/ghostty/shaders/retro-terminal-flat.glsl" | quote }}
PATCH_FILE={{ joinPath .chezmoi.sourceDir "patches/retro-terminal-flat.glsl.diff" | quote }}
RETRO_INCLUDE={{ joinPath .chezmoi.homeDir ".config/ghostty/retro.ghostty" | quote }}

# Build the flat CRT shader as a separate file, so the external repo stays clean
# and `ghostty-retro` can switch between both versions.
if [ -d "$SHADER_REPO/.git" ]; then
    original=$(mktemp)
    git -C "$SHADER_REPO" show HEAD:retro-terminal.glsl > "$original" &&
        patch --silent -o "$FLAT_SHADER" "$original" < "$PATCH_FILE" ||
        echo "warning: could not build $FLAT_SHADER" >&2
    rm -f "$original"
fi

# ghostty_retro_terminal sets the starting state; `ghostty-retro` owns it after that
if [ ! -f "$RETRO_INCLUDE" ]; then
    {{ joinPath .chezmoi.homeDir ".local/bin/ghostty-retro" | quote }} {{ if .ghostty_retro_terminal }}on{{ else }}off{{ end }} > /dev/null
fi
