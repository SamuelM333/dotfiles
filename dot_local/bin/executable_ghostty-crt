#!/bin/sh
# Switch the ghostty retro-terminal shader between the flat and curved CRT,
# then reload every running ghostty.
# Usage: ghostty-crt [toggle|flat|curved]   (default: toggle)

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty"
INCLUDE="$CONFIG_DIR/shaders.ghostty"

case "${1:-toggle}" in
    flat) mode=flat ;;
    curved) mode=curved ;;
    toggle)
        if grep -q 'retro-terminal-flat' "$INCLUDE" 2>/dev/null; then
            mode=curved
        else
            mode=flat
        fi
        ;;
    *)
        echo "usage: ghostty-crt [toggle|flat|curved]" >&2
        exit 2
        ;;
esac

if [ "$mode" = flat ]; then
    # Built by chezmoi's run_after script from patches/retro-terminal-flat.glsl.diff
    retro=./shaders/retro-terminal-flat.glsl
else
    retro=./shaders/ghostty-shaders/retro-terminal.glsl
fi

# Ghostty reads this file through `config-file`; chezmoi doesn't manage it
cat > "$INCLUDE" <<EOF
# Written by ghostty-crt ($mode). Run \`ghostty-crt\` or press ^X^S in zsh to switch.
custom-shader = $retro
custom-shader = ./shaders/ghostty-shaders/tft.glsl
custom-shader = ./shaders/ghostty-shaders/bloom.glsl
EOF

# SIGUSR2 makes ghostty reload its config
pkill -USR2 -x ghostty 2>/dev/null
echo "ghostty CRT: $mode"
