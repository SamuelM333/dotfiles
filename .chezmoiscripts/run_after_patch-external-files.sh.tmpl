#!/bin/bash

TARGET_FILE={{ joinPath .chezmoi.homeDir ".config/ghostty/shaders/ghostty-shaders/retro-terminal.glsl" | quote }}
PATCH_FILE={{ joinPath .chezmoi.sourceDir "patches/retro-terminal-flat.glsl.diff" | quote }}

# Check if the target file exists before trying to patch
if [ -f "$TARGET_FILE" ]; then
    # Probe with --dry-run first: it writes nothing, so no .rej files and no
    # "previously applied" noise. A patch that reverses cleanly is already applied.
    if patch -R -f -s --dry-run "$TARGET_FILE" < "$PATCH_FILE" > /dev/null 2>&1; then
        :
    elif patch -f -s --dry-run "$TARGET_FILE" < "$PATCH_FILE" > /dev/null 2>&1; then
        patch -f -s "$TARGET_FILE" < "$PATCH_FILE"
    else
        # Upstream changed the file; warn without halting 'chezmoi apply'
        echo "warning: $PATCH_FILE no longer applies to $TARGET_FILE" >&2
    fi
fi